# Variables de entorno del FRONTEND (Vite). Se leen en BUILD TIME.
# Copiar a `frontend/.env` y completar ANTES de `npm run build` / `npm run deploy`.
# El `.env` real no se commitea; este archivo es la plantilla de referencia.

# URL base del backend. TODO el frontend llama a `${VITE_API_URL}/skin/...`.
# Si falta, las peticiones apuntan a `undefined/skin/...` y fallan.
# En producción debe ser HTTPS (si no, el navegador bloquea por mixed content).
#   Dev local:   http://localhost:8080
#   Producción:  https://TU-SUBDOMINIO.duckdns.org
VITE_API_URL=http://localhost:8080

# Ruta base del build (vite.config.ts). Default `/` (dominio propio / raíz).
# Para GitHub Pages en subruta (usuario.github.io/PielSanaIA-MVP) usar:
#   VITE_BASE=/PielSanaIA-MVP/
VITE_BASE=/
