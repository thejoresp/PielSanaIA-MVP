# Variables de entorno del BACKEND (FastAPI).
# Copiar a `.env` en la raíz del repo y completar. El `.env` real NO se commitea
# (está en .gitignore). Este archivo es solo la plantilla de referencia.

# --- DeepSeek (texto: descripción y recomendaciones) ---
# Requerida para /skin/openai-recomendaciones. Sin ella responde 503.
# API compatible con OpenAI (base_url https://api.deepseek.com). Nunca commitear la key real.
DEEPSEEK_API_KEY=sk-...
# Modelo de texto (opcional). Default: deepseek-v4-flash.
# Ojo: deepseek-chat / deepseek-reasoner se deprecan el 2026/07/24.
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- OpenAI (solo visión: endpoint /skin/openai-analizar "Detectar Condición") ---
# OPCIONAL. DeepSeek no acepta imágenes por API, así que la detección automática
# desde la foto usa gpt-4o. Sin esta key, ese endpoint responde 503 pero el resto
# de la app funciona con DeepSeek. Dejar vacío si no se usa esa función.
# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o

# --- CORS ---
# Orígenes permitidos por el navegador, separados por comas (sin espacios de más).
# Default si no se define: dev local (http://localhost:5173,http://127.0.0.1:5173).
# EN PRODUCCIÓN definir la URL real del frontend, p. ej. GitHub Pages:
#   FRONTEND_ORIGINS=https://USUARIO.github.io
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rutas de los modelos Keras (opcionales; tienen default) ---
# Los .keras no están versionados; copiarlos al servidor. Solo definir estas
# variables si las rutas difieren de las de config/model_config.py.
# LUNARES_MODEL_PATH=backend/modelos/ham10000/lunares.keras
# ACNE_MODEL_PATH=backend/modelos/acne/acne.keras
# ROSACEA_MODEL_PATH=backend/modelos/rosacea/rosacea.keras
